# online/ — supplements root .gitignore with module-specific bits.

# Doppler tokens (the `task` commands shell in via DOPPLER_TOKEN=$(cat ...)).
.doppler-*
.doppler-dev-online

# Local env overrides.
.env
.env.local
*.local.*

# Go / build artefacts.
backend/main
backend/tmp/
**/tmp/
/bin/
/dist/
*.test
*.out

# DB dumps + SQLite snapshots.
*.db
*.db-shm
*.db-wal
dumps/
*.sql.bak

# Python.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Claude Code local/session files (CLAUDE.md stays tracked).
.claude/
CLAUDE.local.md

# OS / editor junk.
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python test caches.
__pycache__/
*.pyc
